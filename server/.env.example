# Copy this file to .env and fill it in. .env is gitignored on purpose:
# a connection string in a public repo is a database anyone can read.

# Atlas -> Connect -> Drivers. Percent-encode any @ : / ? # in the password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# The port the API listens on.
PORT=8787
