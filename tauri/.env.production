# The address built apps talk to. This one is NOT a secret — it is the same
# public URL anyone can see in the app, so it belongs in git: every release
# the workflow builds then points at the real server without any setup.
#
# `npm run dev` ignores this file (that's development, not production) and
# still talks to http://127.0.0.1:8787, so your own server keeps working.
#
# If you rename the service on Render, change this line and tag a new build.
VITE_API_URL=https://lab-report-filler-api.onrender.com
