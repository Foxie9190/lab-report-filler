# Copy to .env.production (or .env) and set the address of your API server.
# Vite bakes this into the built app, so the installer you hand out points at
# the real server and nobody has to type anything.
#
# Left unset, the app talks to http://127.0.0.1:8787 — your own machine.
VITE_API_URL=https://your-server-address-here
