{
  // Use the project's own virtual environment, not the system Python.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,

  // Hide the noise.
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },

  // Trim trailing whitespace, keep files tidy.
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "[python]": {
    "editor.rulers": [88],
    "editor.tabSize": 4
  }
}
