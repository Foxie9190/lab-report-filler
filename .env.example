# Copy this file to ".env" and paste your real key in.
# .env is gitignored, so your key never gets committed.
#
# Get a key at: https://console.anthropic.com  ->  API Keys
# You need a few dollars of credit on the account. Reading one lab photo
# costs well under a cent.
#
# The app works WITHOUT this — you just type your data in instead.

ANTHROPIC_API_KEY=sk-ant-put-your-key-here
